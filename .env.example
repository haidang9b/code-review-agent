# ---- Azure OpenAI (chat + embeddings) ----
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5.4-nano
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=your-embedding-deployment-name

# Optional: a stronger deployment used ONLY for the review + verification nodes.
# Code review benefits a lot from a larger model; falls back to
# AZURE_OPENAI_DEPLOYMENT_NAME when unset.
AZURE_OPENAI_REVIEW_DEPLOYMENT=

# ---- GitHub ----
# Personal access token with `repo` (private repos) or `public_repo` scope.
# Leave empty to use the unauthenticated API (public repos only, 60 req/hour).
GITHUB_TOKEN=
# Override for GitHub Enterprise Server, e.g. https://github.mycompany.com/api/v3
GITHUB_API_URL=https://api.github.com

# ---- Local corpora ----
# Local checkout of the project whose code should be indexed as
# "Existing Project Patterns" (tier 3). Required for `ingest-code`.
REPO_PATH=
# Folder holding coding standards / ADRs / design docs (.md, .pdf, .docx).
KNOWLEDGE_PATH=knowledge

# ---- Review limits ----
MAX_FILES_PER_REVIEW=25
MAX_PATCH_CHARS=12000

# ---- LangSmith tracing (optional) ----
# Tracing turns itself on when LANGSMITH_API_KEY is set, and off when it is not,
# so leave LANGSMITH_TRACING alone unless you want to force it.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-code-review
